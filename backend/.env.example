# Anthropic — fill in your API key
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth2 — enables "Sign in with Google" + Gmail API (instant speed)
# Setup (one-time):
#   1. Go to https://console.cloud.google.com → create a project
#   2. Enable "Gmail API" and "Google Calendar API" under APIs & Services
#   3. Go to APIs & Services → Credentials → Create OAuth 2.0 Client ID
#      - Application type: Web application
#      - Authorized JavaScript origins: http://localhost:3000
#      - Authorized redirect URIs: http://localhost:8000/api/auth/callback
#   4. Copy the Client ID and Client Secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# App
SECRET_KEY=hive-dev-secret-key-change-me
FRONTEND_URL=http://localhost:3000
BACKEND_PORT=8000

# Browser harness (Playwright fallback when no OAuth)
BROWSER_POOL_SIZE=8

# LLM Provider (optional — defaults to anthropic)
# Options: anthropic, vllm, openai_compat
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_MODEL=kimi-k2.5-72b
# LLM_API_KEY=
